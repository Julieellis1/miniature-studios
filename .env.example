# Copy to .env and fill in (Neon Postgres + single-user gate + Neon Storage)
DATABASE_URL="postgresql://..."
APP_PASSWORD="change-me"

# Neon Storage (S3-compatible private bucket `characters` for character images)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""

# Optional: provider request budget in ms (default 300000). Vercel Hobby
# caps functions below this regardless.
# CHAT_TIMEOUT_MS="300000"
